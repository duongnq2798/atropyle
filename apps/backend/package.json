{
  "name": "@atropyle/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Supabase Edge Functions, email and keeper for Atropyle (spec 2026-11-22 §9).",
  "scripts": {
    "build": "tsx build.ts",
    "emails": "tsx scripts/emails.ts",
    "emails:check": "tsx scripts/emails.ts --check",
    "emails:preview": "tsx scripts/preview-emails.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "rehearse:drills": "tsx scripts/rehearse-drills.ts"
  },
  "dependencies": {
    "@atropyle/sdk": "0.1.0",
    "postgres": "3.4.9",
    "viem": "2.58.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@react-email/components": "1.0.12",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
