{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!circuits",
      "!contracts",
      "!**/dist",
      "!**/node_modules",
      "!packages/sdk/src/abi/generated.ts",
      "!packages/sdk/src/deployments/local.ts",
      "!packages/sdk/src/deployments/xlayer.ts",
      "!packages/sdk/src/deployments/team.ts",
      "!deployments",
      "!prompts",
      "!reports",
      "!research_notes",
      "!external_research",
      "!docs",
      "!skills/**/*.md",
      "!packages/cli/schemas",
      "!packages/cli/test/snapshots",
      "!.superpowers",
      "!site-dist",
      "!apps/web-legacy/dist",
      "!apps/web-legacy/dist-e2e",
      "!apps/web-legacy/test-results",
      "!apps/web-legacy/playwright-report",
      "!apps/web-legacy/test/e2e/.state.json",
      "!apps/web/.next",
      "!apps/web/out",
      "!apps/web/next-env.d.ts",
      "!apps/web/test/build/.out",
      "!apps/web/test/e2e/.site",
      "!apps/web/test/e2e/.state.json",
      "!apps/web/test-results",
      "!apps/web/playwright-report",
      "!apps/web/lighthouse-report",
      "!apps/web/.size",
      "!apps/backend/src/email/templates.gen.ts",
      "!apps/backend/test/__snapshots__",
      "!apps/backend/.preview",
      "!supabase/functions"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "error" }
    }
  }
}
